@model Ngay6_KTPMK22B.Models.Genre

@{
    ViewData["Title"] = "Delete Genre";
}

<h1>Delete Genre</h1>

<h3>Are you sure you want to delete this genre?</h3>

<div>
    <dl>
        <dt>Name</dt>
        <dd>@Model.Name</dd>

        <dt>Movies</dt>
        <dd>
            @if (Model.Movies != null && Model.Movies.Count > 0)
            {
                <div style="color: red;">
                    <strong>Warning:</strong> This genre has @Model.Movies.Count movie(s). 
                    Deleting this genre will also delete the following movies:
                    <ul>
                        @foreach (var movie in Model.Movies)
                        {
                            <li>@movie.Title</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <p>No movies in this genre.</p>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit">Delete</button>
        <a asp-action="Index">Cancel</a>
    </form>
</div>

